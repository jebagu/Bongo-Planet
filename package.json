{
  "name": "bongo-planet",
  "version": "0.1.0",
  "description": "Bongo Planet \u2014 a musical constellation on a sphere",
  "scripts": {
    "dev": "vite",
    "preview": "vite preview",
    "build": "npm run docs:agents && tsc --noEmit && vite build",
    "docs:agents": "tsx scripts/generate-agent-guide.ts",
    "songs": "tsx scripts/generate-songbook.ts && tsx scripts/generate-classics.ts && tsx scripts/generate-game-themes.ts && tsx scripts/generate-reworked-songs.ts",
    "songs:classics": "tsx scripts/generate-classics.ts",
    "songs:reworked": "tsx scripts/generate-reworked-songs.ts",
    "songs:chords": "tsx scripts/compose-chord-favorites.ts",
    "songs:games": "tsx scripts/generate-game-themes.ts",
    "typecheck": "tsc --noEmit",
    "test:engine": "vitest run tests/core.test.ts tests/engine.test.ts",
    "test": "vitest run",
    "verify": "npm run build && npm test && npm run test:web",
    "fixtures": "tsx scripts/fixtures.ts",
    "bridge": "tsx src/output/bridge.ts",
    "test:audio": "vitest run tests/audio.test.ts",
    "test:bridge": "vitest run tests/bridge.test.ts",
    "test:web": "playwright test",
    "songs:pop": "tsx scripts/compose-pop-songs.ts",
    "songs:ambient": "tsx scripts/compose-ambient-routing.ts",
    "songs:loops": "tsx scripts/compose-loop-builds.ts",
    "songs:drum-builds": "tsx scripts/compose-drum-builds.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "three": "^0.186.1",
    "ws": "^8.22.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/node": "^26.6.5",
    "@types/three": "^0.186.0",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "private": true,
  "type": "module"
}
